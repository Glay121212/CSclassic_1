rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return true;
    }

    function isUser(uid) {
      return true;
    }

    // Player profiles and stats
    match /players/{uid} {
      allow read: if isSignedIn();

      // Create initial profile
      allow create: if isUser(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.elo == 1000
        && request.resource.data.w == 0
        && request.resource.data.l == 0;

      // Update profile: name edit or match rating delta
      allow update: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && (
          // Name or metadata update without changing Elo/records
          (
            request.resource.data.elo == resource.data.elo
            && request.resource.data.w == resource.data.w
            && request.resource.data.l == resource.data.l
            && request.resource.data.lastMatch == resource.data.lastMatch
          )
          ||
          // Rating update verified by finished match doc
          (
            request.resource.data.lastMatch != resource.data.lastMatch
            && request.resource.data.lastMatch is string
            && request.resource.data.elo is int
            && request.resource.data.elo >= 100
            && math.abs(request.resource.data.elo - resource.data.elo) <= 40
            && exists(/databases/$(database)/documents/matches/$(request.resource.data.lastMatch))
            && get(/databases/$(database)/documents/matches/$(request.resource.data.lastMatch)).data.done == true
            && (request.resource.data.elo - resource.data.elo) == get(/databases/$(database)/documents/matches/$(request.resource.data.lastMatch)).data.result.d[uid]
          )
        );

      allow delete: if false;
    }

    // Matchmaking queue
    match /queue/{uid} {
      allow read: if isSignedIn();

      // User creates/updates own queue presence
      allow create, update: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.region in ['Europe', 'Americas', 'Asia']
        && request.resource.data.maps is list
        && request.resource.data.maps.size() >= 1;

      // Deletion allowed for owner on leave or by any signed-in user during 10-player match creation transaction
      allow delete: if isSignedIn();
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isSignedIn();

      // Created atomically when 10 players in a region match up
      allow create: if isSignedIn()
        && request.resource.data.pids is list
        && request.resource.data.pids.size() == 10
        && request.resource.data.a is list
        && request.resource.data.a.size() == 5
        && request.resource.data.b is list
        && request.resource.data.b.size() == 5
        && request.resource.data.host in request.resource.data.pids
        && request.resource.data.done == false;

      // Host writes server addr, or participants record done + quorum result
      allow update: if isSignedIn()
        && (
          // Host sharing IP:Port
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addr'])
          ||
          // Participants recording match finish and deterministic outcome
          (
            resource.data.done == false
            && request.resource.data.done == true
            && request.resource.data.result.win in ['A', 'B', 'X']
          )
        );

      allow delete: if false;

      // Match outcome reports
      match /reports/{uid} {
        allow read: if isSignedIn();

        // One report per match participant
        allow create, update: if isSignedIn()
          && request.resource.data.w in ['A', 'B', 'X'];

        allow delete: if false;
      }
    }
  }
}
